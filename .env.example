# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/food_app

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=food_knowledge

# Chat Feature (OpenAI)
CHAT_API_KEY=your_openai_api_key_here
CHAT_BASE_URL=https://aiportalapi.stu-platform.live/jpe
CHAT_MODEL=gpt-4o-mini

# Voice Feature (Whisper + TTS)
VOICE_API_KEY=your_openai_api_key_here
VOICE_BASE_URL=https://aiportalapi.stu-platform.live/jpe
VOICE_WHISPER_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
VOICE_TTS_SPEED=1.0

# Image Feature (Vision)
IMAGE_API_KEY=your_openai_api_key_here
IMAGE_BASE_URL=https://aiportalapi.stu-platform.live/jpe
IMAGE_MODEL=gpt-4o-mini

# Embedding Feature (RAG)
EMBEDDING_API_KEY=your_openai_api_key_here
EMBEDDING_BASE_URL=https://aiportalapi.stu-platform.live/jpe
EMBEDDING_MODEL=text-embedding-3-small

# Security
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
