      "steps": [
        {
          "step_number": 1,
          "title_vi": "Chuẩn bị nguyên liệu",
          "title_en": "Prepare ingredients",
          "instruction_vi": "Rửa sạch xương bò, ngâm nước lạnh trong 30 phút để loại bỏ tạp chất và máu. Gừng và hành tây đem nướng trên bếp cho thơm.",
          "instruction_en": "Clean beef bones thoroughly, soak in cold water for 30 minutes to remove impurities and blood. Grill ginger and onions over flame until fragrant.",
          "image_url": "https://storage.cooking.app/steps/pho-step1.jpg",
          "video_url": null,
          "duration_minutes": 30,
          "timer_label_vi": "Ngâm xương",
          "timer_label_en": "Soaking bones",
          "timer_seconds": 1800,
          "timer_alert_sound": "gentle_bell",
          "tips": "Việc ngâm xương giúp nước dùng trong hơn. Nướng gừng hành giúp tăng hương vị."
        },
        {
          "step_number": 2,
          "title_vi": "Chần xương",
          "title_en": "Blanch bones",
          "instruction_vi": "Cho xương vào nồi nước sôi, chần trong 5 phút. Vớt ra rửa sạch với nước lạnh để loại bỏ tạp chất.",
          "instruction_en": "Put bones in boiling water, blanch for 5 minutes. Remove and rinse with cold water to remove impurities.",
          "image_url": "https://storage.cooking.app/steps/pho-step2.jpg",
          "video_url": null,
          "duration_minutes": 5,
          "timer_label_vi": "Chần xương",
          "timer_label_en": "Blanching bones",
          "timer_seconds": 300,
          "timer_alert_sound": "soft_chime",
          "tips": "Chần xương là bước quan trọng để có nước dùng trong và không tanh."
        },
        {
          "step_number": 3,
          "title_vi": "Hầm nước dùng",
          "title_en": "Simmer broth",
          "instruction_vi": "Cho xương đã chần, gừng và hành nướng vào nồi lớn. Đổ 4 lít nước, đun sôi rồi hạ lửa nhỏ. Hầm trong 10-12 tiếng, thỉnh thoảng vớt bọt.",
          "instruction_en": "Add blanched bones, grilled ginger and onions to large pot. Pour 4 liters of water, bring to boil then reduce heat. Simmer for 10-12 hours, occasionally skim off foam.",
          "image_url": "https://storage.cooking.app/steps/pho-step3.jpg",
          "video_url": null,
          "duration_minutes": 720,
          "timer_label_vi": "Hầm nước phở",
          "timer_label_en": "Simmering broth",
          "timer_seconds": 43200,
          "timer_alert_sound": "cooking_bell",
          "tips": "Hầm lửa nhỏ để nước dùng trong. Nếu vội có thể dùng nồi áp suất (2-3 tiếng)."
        },
        {
          "step_number": 4,
          "title_vi": "Nêm nếm nước dùng",
          "title_en": "Season the broth",
          "instruction_vi": "Khi nước dùng đã trong và thơm, nêm nếm với muối, đường, nước mắm cho vừa khẩu vị. Lọc bỏ xương và phần cặn.",
          "instruction_en": "When broth is clear and aromatic, season with salt, sugar, and fish sauce to taste. Strain out bones and sediment.",
          "image_url": "https://storage.cooking.app/steps/pho-step4.jpg",
          "video_url": null,
          "duration_minutes": 10,
          "timer_label_vi": null,
          "timer_label_en": null,
          "timer_seconds": null,
          "timer_alert_sound": null,
          "tips": "Nước dùng ngon là linh hồn của tô phở. Nêm nếm từ từ để đạt vị cân bằng."
        },
        {
          "step_number": 5,
          "title_vi": "Chuẩn bị thịt và bánh phở",
          "title_en": "Prepare beef and noodles",
          "instruction_vi": "Thái thịt bò mỏng. Trụng bánh phở với nước sôi trong 1-2 phút, vớt ra để ráo nước.",
          "instruction_en": "Slice beef thinly. Blanch pho noodles in boiling water for 1-2 minutes, drain well.",
          "image_url": "https://storage.cooking.app/steps/pho-step5.jpg",
          "video_url": null,
          "duration_minutes": 5,
          "timer_label_vi": "Trụng bánh phở",
          "timer_label_en": "Blanching noodles",
          "timer_seconds": 120,
          "timer_alert_sound": "quick_beep",
          "tips": "Thịt thái mỏng sẽ chín vừa đủ khi chan nước dùng nóng."
        },
        {
          "step_number": 6,
          "title_vi": "Chuẩn bị rau ăn kèm",
          "title_en": "Prepare fresh herbs",
          "instruction_vi": "Rửa sạch hành lá, ngò rí. Thái hành lá nhỏ, để riêng lá ngò.",
          "instruction_en": "Wash spring onions and cilantro. Chop spring onions finely, separate cilantro leaves.",
          "image_url": "https://storage.cooking.app/steps/pho-step6.jpg",
          "video_url": null,
          "duration_minutes": 5,
          "timer_label_vi": null,
          "timer_label_en": null,
          "timer_seconds": null,
          "timer_alert_sound": null,
          "tips": "Rau thơm tươi là điểm nhấn quan trọng của phở Bắc."
        },
        {
          "step_number": 7,
          "title_vi": "Trình bày",
          "title_en": "Assemble the bowl",
          "instruction_vi": "Cho bánh phở vào tô, xếp thịt bò lên trên. Rắc hành lá, ngò rí lên mặt.",
          "instruction_en": "Place noodles in bowl, arrange beef slices on top. Sprinkle spring onions and cilantro over.",
          "image_url": "https://storage.cooking.app/steps/pho-step7.jpg",
          "video_url": null,
          "duration_minutes": 2,
          "timer_label_vi": null,
          "timer_label_en": null,
          "timer_seconds": null,
          "timer_alert_sound": null,
          "tips": "Trình bày đẹp mắt giúp món ăn hấp dẫn hơn."
        },
        {
          "step_number": 8,
          "title_vi": "Hoàn thành",
          "title_en": "Finish",
          "instruction_vi": "Chan nước dùng sôi lên tô phở. Thưởng thức ngay khi còn nóng, ăn kèm chanh, ớt, rau thơm.",
          "instruction_en": "Pour hot broth over the noodles. Serve immediately while hot with lime, chili, and fresh herbs on the side.",
